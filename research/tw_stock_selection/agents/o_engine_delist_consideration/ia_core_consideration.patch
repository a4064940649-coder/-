+# ---------------- 下市對價口徑（o_engine_delist_consideration） ----------------
+def _lt_engine(j, term, TR, IDX):
+    w = np.flatnonzero(TR[:, j])
+    if term is not None: w = w[IDX[w] <= term]
+    return int(w[-1]) if len(w) else -1
