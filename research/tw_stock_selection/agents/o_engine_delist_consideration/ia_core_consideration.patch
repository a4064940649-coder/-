+def _solve(htr, cash, pk, buy, sell):
+    N = len(htr); Vt = htr.sum() + cash; k = len(pk)
+    def cost_of(T):
+        tgt = np.zeros(N); tgt[pk] = T
+        return buy * np.clip(tgt - htr, 0, None).sum() + sell * np.clip(htr - tgt, 0, None).sum()
+    lo, hi = 0.0, Vt / k
+    for _ in range(60):
+        mid = 0.5 * (lo + hi)
+        if mid * k + cost_of(mid) > Vt: hi = mid
+        else: lo = mid
+    return lo, Vt
+
+
+def _sim_consideration(plan, buy, sell, t0, t1, settle, ret_override):
+    G = GROW if ret_override is None else ret_override
+    NN = N; reb = {p[0]: p[1] for p in plan}
+    E5n = E50.to_numpy()
+    trig = {}
+    for j, rules in settle.items():
+        for ru in rules: trig.setdefault(ru['trig'], []).append((j, ru))
+    val = np.zeros(NN); cash = 0.0 + 1.0
+    claims = []   # dict(kind, value, rel, succ?, q?)
+    nav = np.empty(t1 - t0 + 1); tov = []; frozen_ev = []; settled = []
+    for t in range(t0, t1 + 1):
+        # 1) 觸發：lt 後第一個交易日把持有部位轉成請求權
+        for j, ru in trig.get(t, []):
+            if val[j] <= 0 or t <= t0: continue
+            V = val[j]; sh = V / ru['lc']; val[j] = 0.0
+            ev = dict(date=str(IDX[t].date()), code=ru['code'], type=ru['type'], value_lastclose=float(V), parts=[])
+            for p in ru['parts']:
+                if p['kind'] == 'cash':
+                    claims.append(dict(kind='cash', value=sh * p['per_share'], rel=max(p['rel'], t), c50=ru['cash_0050'], ev=ev))
+                elif p['kind'] == 'fixed_sell':
+                    claims.append(dict(kind='fixed_sell', value=sh * p['per_share'], rel=max(p['rel'], t), zero=p.get('zero', False), ev=ev))
+                elif p['kind'] == 'stock':
+                    claims.append(dict(kind='stock', value=sh * p['per_share_window'], rel=max(p['rel'], t), succ=p['succ'], q=sh * p['ratio'], ev=ev))
+            settled.append(ev)
+        # 2) 0050 計值的現金請求權（A16 敏感度）
+        if t > t0:
+            r50 = E5n[t] / E5n[t - 1] if np.isfinite(E5n[t]) and np.isfinite(E5n[t - 1]) else 1.0
+            for c in claims:
+                if c['kind'] == 'cash' and c.get('c50') and t <= c['rel']: c['value'] *= r50
+        isreb = t in reb
+        # 3) 到期：現金入帳；股票請求權在 s 轉成存續股（s 為換股日時以開盤價計入）
+        keep = []
+        add_open = np.zeros(NN)
+        for c in claims:
+            if t >= c['rel']:
+                if c['kind'] == 'cash':
+                    cash += c['value']; c['ev']['parts'].append(('cash', str(IDX[t].date()), float(c['value'])))
+                    continue
+                if c['kind'] == 'stock':
+                    sj = c['succ']
+                    if isreb: add_open[sj] += c['q'] * On[t, sj]
+                    else: val[sj] += c['q'] * Cn[t, sj] / G[t, sj]   # 之後乘上當日 G → 收盤值 q×C
+                    c['ev']['parts'].append(('stock', str(IDX[t].date()), COLS[sj], float(c['q'] * (On[t, sj] if isreb else Cn[t, sj]))))
+                    continue
+                if c['kind'] == 'fixed_sell' and isreb:
+                    pr = 0.0 if c.get('zero') else c['value'] * (1 - sell)
+                    cash += pr; c['ev']['parts'].append(('writeoff' if c.get('zero') else 'fixed_sell', str(IDX[t].date()), float(pr)))
+                    continue
+            keep.append(c)
+        claims = keep
+        if isreb:
+            pk = reb[t]
+            tr = TRADED[t] & np.isfinite(On[t])
+            gap = np.where(tr, G[t] * On[t] / np.where(tr, Cn[t], 1.0), 1.0)
+            h = val * gap + add_open
+            frz = (h > 0) & ~tr
+            Vfz = h[frz].sum(); htr = np.where(frz, 0.0, h)
+            Vcl = sum(c['value'] for c in claims)
+            T, Vt = _solve(htr, cash, pk, buy, sell)
+            tgt = np.zeros(NN); tgt[pk] = T
+            tov.append(np.clip(htr - tgt, 0, None).sum() / (Vt + Vfz + Vcl))
+            newval = np.where(frz, h, 0.0); newval[pk] += T
+            oc = np.where(tr, Cn[t] / np.where(tr, On[t], 1.0), 1.0)
+            val = np.where(frz, newval, newval * oc); cash = 0.0
+            if frz.any() or claims:
+                frozen_ev.append((str(IDX[t].date()), [COLS[j] for j in np.where(frz)[0]], float((Vfz + Vcl) / (Vt + Vfz + Vcl))))
+        else:
+            val = val * G[t] if t > t0 else val
+        nav[t - t0] = val.sum() + cash + sum(c['value'] for c in claims)
+    return pd.Series(nav, index=IDX[t0:t1 + 1]), {'turnover': float(np.mean(tov[1:])) if len(tov) > 1 else np.nan, 'frozen': frozen_ev, 'settled': settled}
